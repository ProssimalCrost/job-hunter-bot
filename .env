# --- WhatsApp via CallMeBot (gratuito, sem Twilio) ---
# 1. Salve +34 644 59 71 67 nos seus contatos como "CallMeBot"
# 2. Mande no WhatsApp: "I allow callmebot to send me messages"
# 3. Você recebe um APIKEY de volta. Cole aqui embaixo.
CALLMEBOT_PHONE=5531935005003
CALLMEBOT_APIKEY=4390776

# --- Busca ---
# Palavras-chave de TI, separadas por vírgula
KEYWORDS=JavaScript,TypeScript,Node.js,Spring Boot,.NET
# Palavras-chave de Engenharia Elétrica (mesmos níveis e mesmas condições)
KEYWORDS_ELETRICA=Engenharia Elétrica,Engenheiro Eletricista,Automação Industrial,Elétrica Industrial,Manutenção Elétrica,Projetos Elétricos
# Níveis aceitos (convertidos pro filtro nativo f_E do LinkedIn)
LEVELS=estagio,junior,pleno

# Busca REMOTA: escopo nacional + filtro nativo de remoto do LinkedIn
SEARCH_LOCATION=Brasil

# Busca LOCAL (LinkedIn): cidade de referência + raio em milhas.
# 15mi (~24km) cobre Ipatinga + Coronel Fabriciano/Timóteo/Santana do
# Paraíso, mas EXCLUI Itabira (~30km) — ajuste se quiser mais/menos.
LOCAL_SEARCH_LOCATION=Ipatinga, Minas Gerais, Brasil
LOCAL_DISTANCE_MILES=15

# Busca LOCAL (Catho): formato diferente do LinkedIn, cidade+UF separados
LOCAL_CITY=Ipatinga
LOCAL_STATE_ABBR=MG

# Busca LOCAL (Gupy): empresas a monitorar, por subdomínio
# (ex: "usiminas" = usiminas.gupy.io). Pra descobrir se uma empresa usa
# Gupy, tente abrir https://<nome>.gupy.io/ no navegador.
GUPY_COMPANIES=usiminas

# Termos aceitos no filtro de local pós-coleta (separados por vírgula)
LOCATION_TERMS=remote,remoto,home office,brasil,ipatinga,coronel fabriciano,timoteo,santana do paraiso,vale do aco,minas gerais,mg
