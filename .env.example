# --- WhatsApp via CallMeBot (gratuito, sem Twilio) ---
# 1. O número do bot muda de tempos em tempos — confira o número ATUAL em
#    https://www.callmebot.com/blog/free-api-whatsapp-messages/ antes de salvar.
# 2. Mande no WhatsApp pro número do bot: "I allow callmebot to send me messages"
# 3. Você recebe um APIKEY de volta. Cole aqui embaixo.
# IMPORTANTE: o telefone precisa ter o "+" e o DDI, exatamente como no WhatsApp.
CALLMEBOT_PHONE=+5531999999999
CALLMEBOT_APIKEY=123456

# --- Busca ---
# Palavras-chave separadas por vírgula
KEYWORDS=JavaScript,TypeScript,Node.js,Spring Boot,.NET
# Níveis aceitos (convertidos pro filtro nativo f_E do LinkedIn)
LEVELS=estagio,junior,pleno

# Busca REMOTA: escopo nacional + filtro nativo de remoto do LinkedIn
SEARCH_LOCATION=Brasil

# Busca LOCAL: cidade de referência + raio (em milhas). Ipatinga é a maior
# cidade do Vale do Aço, colada em Timóteo.
LOCAL_SEARCH_LOCATION=Ipatinga, Minas Gerais, Brasil
LOCAL_DISTANCE_MILES=50

# Termos aceitos no filtro de local pós-coleta (separados por vírgula)
LOCATION_TERMS=remote,remoto,home office,brasil,ipatinga,coronel fabriciano,timoteo,santana do paraiso,vale do aco,minas gerais,mg
